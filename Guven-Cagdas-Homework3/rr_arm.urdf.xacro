<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="rr_arm">

  <!-- Link 1 -->
  <link name="link1">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="3.0"/> <!-- Shape: Cylinder -->
      </geometry>
      <material name="blue"> <!-- Color: Blue -->
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="3.0"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 1.5"/> <!-- Cylinder center -->
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Link 2 -->
  <link name="link2">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="2.0"/> <!-- Shape: Cylinder -->
      </geometry>
      <material name="red"> <!-- Color: Red -->
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="2.0"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 1.0"/>
      <inertia ixx="0.08" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.08"/>
    </inertial>
  </link>

  <!-- End Effector -->
  <link name="end_effector">
    <visual>
      <geometry>
        <sphere radius="0.1"/> <!-- Shape: Sphere -->
      </geometry>
      <material name="orange"> <!-- Color: Orange -->
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <!-- Joint 0 -->
  <joint name="joint_0" type="revolute">
    <parent link="world"/> <!-- Connected to the world -->
    <child link="link1"/> <!-- First link -->
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- Joint 1 -->
  <joint name="joint_1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 3.0" rpy="0 0 0"/> <!-- At the end of link1 -->
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <!-- Joint 2 (End Effector) -->
  <joint name="joint_2" type="fixed">
    <parent link="link2"/>
    <child link="end_effector"/>
    <origin xyz="0 0 2.0" rpy="0 0 0"/> <!-- At the end of link2 -->
  </joint>

</robot>
